+import type { LoadBalancingStrategy } from "@ccflare/core";
+import { StrategyName } from "@ccflare/types";
+import {
+	LeastUsedStrategy,
+	ModelAwareStrategy,
+	RoundRobinStrategy,
+	SessionAwareStrategy,
+	SessionStrategy,
+	WeightedStrategy,
+} from "./strategies";
+
+/**
+ * Factory function to create load balancing strategies
+ */
+export function createStrategy(
+	strategyName: StrategyName,
+	sessionDurationMs: number = 5 * 60 * 60 * 1000,
+): LoadBalancingStrategy {
+	switch (strategyName) {
+		case StrategyName.Session:
+			return new SessionStrategy(sessionDurationMs);
+
+		case StrategyName.RoundRobin:
+			return new RoundRobinStrategy();
+
+		case StrategyName.LeastUsed:
+			return new LeastUsedStrategy(sessionDurationMs);
+
+		case StrategyName.Weighted:
+			return new WeightedStrategy();
+
+		case StrategyName.ModelAware:
+			return new ModelAwareStrategy();
+
+		default:
+			// For the enhanced session strategy, map to SessionAware
+			// This allows backwards compatibility while providing better OAuth handling
+			return new SessionAwareStrategy(sessionDurationMs);
+	}
+}
+
+/**
+ * Get a human-readable description of a strategy
+ */
+export function getStrategyDescription(strategyName: StrategyName): string {
+	switch (strategyName) {
+		case StrategyName.Session:
+			return "Maintains 5-hour sessions with a single account to minimize rate limits";
+
+		case StrategyName.RoundRobin:
+			return "Cycles through accounts evenly to distribute load equally";
+
+		case StrategyName.LeastUsed:
+			return "Prioritizes accounts with lowest usage to balance over time";
+
+		case StrategyName.Weighted:
+			return "Uses account weights based on plan type (Max accounts get more requests)";
+
+		case StrategyName.ModelAware:
+			return "Routes requests based on Claude model compatibility with account plans";
+
+		default:
+			return "Unknown strategy";
+	}
+}
