+import { Config } from "@ccflare/config";
+import { getStrategyDescription } from "@ccflare/load-balancer";
+import { StrategyName } from "@ccflare/types";
+
+/**
+ * Handle strategy-related CLI commands
+ */
+export function handleStrategyCommand(args: string[]): void {
+	const subCommand = args[0];
+
+	switch (subCommand) {
+		case "list":
+			listStrategies();
+			break;
+		case "set":
+			setStrategy(args[1]);
+			break;
+		case "get":
+		case "current":
+			getCurrentStrategy();
+			break;
+		default:
+			showStrategyHelp();
+			break;
+	}
+}
+
+function listStrategies(): void {
+	console.log("Available load balancing strategies:");
+	console.log("");
+
+	const strategies = Object.values(StrategyName);
+	const config = new Config();
+	const currentStrategy = config.getStrategy();
+
+	for (const strategy of strategies) {
+		const isCurrent = strategy === currentStrategy;
+		const prefix = isCurrent ? "→" : " ";
+		const description = getStrategyDescription(strategy as StrategyName);
+
+		console.log(`${prefix} ${strategy.padEnd(15)} ${description}`);
+	}
+
+	console.log("");
+	console.log(`Current strategy: ${currentStrategy}`);
+}
+
+function setStrategy(strategyName: string): void {
+	if (!strategyName) {
+		console.error("Strategy name is required");
+		console.log("Use 'strategy list' to see available strategies");
+		process.exit(1);
+	}
+
+	const strategies = Object.values(StrategyName);
+	if (!strategies.includes(strategyName as StrategyName)) {
+		console.error(`Invalid strategy: ${strategyName}`);
+		console.log("Available strategies:");
+		for (const strategy of strategies) {
+			console.log(`  ${strategy}`);
+		}
+		process.exit(1);
+	}
+
+	const config = new Config();
+	config.set("lb_strategy", strategyName);
+
+	console.log(`✅ Load balancing strategy set to: ${strategyName}`);
+	console.log(`   ${getStrategyDescription(strategyName as StrategyName)}`);
+}
+
+function getCurrentStrategy(): void {
+	const config = new Config();
+	const currentStrategy = config.getStrategy();
+	const description = getStrategyDescription(currentStrategy);
+
+	console.log(`Current strategy: ${currentStrategy}`);
+	console.log(`Description: ${description}`);
+}
+
+function showStrategyHelp(): void {
+	console.log(`
+Strategy Management Commands:
+
+  strategy list
+    List all available load balancing strategies
+
+  strategy set <strategy-name>
+    Set the current load balancing strategy
+
+  strategy get
+    Show the current load balancing strategy
+
+Available strategies:
+  session      - Maintains 5-hour sessions with a single account
+  round-robin  - Cycles through accounts evenly  
+  least-used   - Prioritizes accounts with lowest usage
+  weighted     - Uses account weights based on plan type
+  model-aware  - Routes based on model compatibility
+
+Examples:
+  ccflare-cli strategy list
+  ccflare-cli strategy set weighted
+  ccflare-cli strategy get
+`);
+}
