+import type {
+	Account,
+	LoadBalancingStrategy,
+	RequestMeta,
+	StrategyStore,
+} from "@ccflare/core";
+import { isAccountAvailable } from "@ccflare/core";
+import { Logger } from "@ccflare/logger";
+
+/**
+ * Least-used strategy that prioritizes accounts with lowest usage
+ * Uses session_request_count within current 5-hour window
+ */
+export class LeastUsedStrategy implements LoadBalancingStrategy {
+	private store: StrategyStore | null = null;
+	private log = new Logger("LeastUsedStrategy");
+	private sessionDurationMs: number;
+
+	constructor(sessionDurationMs: number = 5 * 60 * 60 * 1000) {
+		this.sessionDurationMs = sessionDurationMs;
+	}
+
+	initialize(store: StrategyStore): void {
+		this.store = store;
+	}
+
+	private getSessionUsage(account: Account, now: number): number {
+		// If no session started or session expired, usage is 0
+		if (
+			!account.session_start ||
+			now - account.session_start >= this.sessionDurationMs
+		) {
+			return 0;
+		}
+		return account.session_request_count || 0;
+	}
+
+	select(accounts: Account[], _meta: RequestMeta): Account[] {
+		const now = Date.now();
+		const available = accounts.filter((a) => isAccountAvailable(a, now));
+
+		if (available.length === 0) {
+			this.log.warn("No available accounts for least-used selection");
+			return [];
+		}
+
+		// Sort by session usage (least used first), then by total requests as tiebreaker
+		available.sort((a, b) => {
+			const aUsage = this.getSessionUsage(a, now);
+			const bUsage = this.getSessionUsage(b, now);
+
+			if (aUsage !== bUsage) {
+				return aUsage - bUsage;
+			}
+
+			// Tiebreaker: use total requests (prefer account with fewer total requests)
+			return a.total_requests - b.total_requests;
+		});
+
+		const selectedAccount = available[0];
+		const sessionUsage = this.getSessionUsage(selectedAccount, now);
+
+		this.log.info(
+			`Least-used selected account ${selectedAccount.name} (session usage: ${sessionUsage}, total: ${selectedAccount.total_requests})`,
+		);
+
+		return available;
+	}
+}
