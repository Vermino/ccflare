+import type {
+	Account,
+	LoadBalancingStrategy,
+	RequestMeta,
+	StrategyStore,
+} from "@ccflare/core";
+import { isAccountAvailable } from "@ccflare/core";
+import { Logger } from "@ccflare/logger";
+
+/**
+ * Enhanced session strategy that maintains 5-hour sessions with OAuth awareness
+ * Includes logic for handling OAuth token expiration and refresh
+ */
+export class SessionAwareStrategy implements LoadBalancingStrategy {
+	private sessionDurationMs: number;
+	private store: StrategyStore | null = null;
+	private log = new Logger("SessionAwareStrategy");
+	private oauthExpiryBuffer: number; // Buffer time before OAuth expiry to trigger refresh
+
+	constructor(
+		sessionDurationMs: number = 5 * 60 * 60 * 1000, // 5 hours
+		oauthExpiryBuffer: number = 30 * 60 * 1000, // 30 minutes buffer
+	) {
+		this.sessionDurationMs = sessionDurationMs;
+		this.oauthExpiryBuffer = oauthExpiryBuffer;
+	}
+
+	initialize(store: StrategyStore): void {
+		this.store = store;
+	}
+
+	private resetSessionIfExpired(account: Account): void {
+		const now = Date.now();
+
+		if (
+			!account.session_start ||
+			now - account.session_start >= this.sessionDurationMs
+		) {
+			// Reset session
+			if (this.store) {
+				const wasExpired = account.session_start !== null;
+				this.log.info(
+					wasExpired
+						? `Session expired for account ${account.name}, starting new session`
+						: `Starting new session for account ${account.name}`,
+				);
+				this.store.resetAccountSession(account.id, now);
+
+				// Update the account object to reflect changes
+				account.session_start = now;
+				account.session_request_count = 0;
+			}
+		}
+	}
+
+	private isOAuthTokenNearExpiry(account: Account, now: number): boolean {
+		if (!account.expires_at) return false;
+		return account.expires_at - now <= this.oauthExpiryBuffer;
+	}
+
+	private needsOAuthRefresh(account: Account, now: number): boolean {
+		// Check if token is expired or near expiry
+		return (
+			!account.expires_at ||
+			account.expires_at <= now ||
+			this.isOAuthTokenNearExpiry(account, now)
+		);
+	}
+
+	select(accounts: Account[], _meta: RequestMeta): Account[] {
+		const now = Date.now();
+
+		// First, identify accounts that need OAuth token refresh
+		const needsRefresh = accounts.filter((account) =>
+			this.needsOAuthRefresh(account, now),
+		);
+
+		if (needsRefresh.length > 0) {
+			this.log.info(
+				`${needsRefresh.length} accounts need OAuth token refresh: ${needsRefresh.map((a) => a.name).join(", ")}`,
+			);
+		}
+
+		// Find account with active session (most recent session_start within window)
+		let activeAccount: Account | null = null;
+		let mostRecentSessionStart = 0;
+
+		for (const account of accounts) {
+			if (
+				account.session_start &&
+				now - account.session_start < this.sessionDurationMs &&
+				account.session_start > mostRecentSessionStart
+			) {
+				activeAccount = account;
+				mostRecentSessionStart = account.session_start;
+			}
+		}
+
+		// If we have an active account and it's available, use it exclusively
+		if (activeAccount && isAccountAvailable(activeAccount, now)) {
+			// Check if OAuth needs refresh but don't block - let the proxy handle it
+			if (this.needsOAuthRefresh(activeAccount, now)) {
+				this.log.warn(
+					`Active account ${activeAccount.name} needs OAuth refresh but continuing session`,
+				);
+			}
+
+			// Reset session if expired (shouldn't happen but just in case)
+			this.resetSessionIfExpired(activeAccount);
+
+			this.log.info(
+				`Continuing session for account ${activeAccount.name} (${activeAccount.session_request_count} requests in session, OAuth expires: ${activeAccount.expires_at ? new Date(activeAccount.expires_at).toISOString() : "unknown"})`,
+			);
+
+			// Return active account first, then others as fallback
+			const others = accounts.filter(
+				(a) => a.id !== activeAccount.id && isAccountAvailable(a, now),
+			);
+			return [activeAccount, ...others];
+		}
+
+		// No active session or active account is rate limited
+		// Filter available accounts, preferring those with fresh OAuth tokens
+		const available = accounts.filter((a) => isAccountAvailable(a, now));
+
+		if (available.length === 0) return [];
+
+		// Sort by OAuth token freshness, then by usage
+		available.sort((a, b) => {
+			const aNeedsRefresh = this.needsOAuthRefresh(a, now);
+			const bNeedsRefresh = this.needsOAuthRefresh(b, now);
+
+			// Prefer accounts that don't need OAuth refresh
+			if (aNeedsRefresh !== bNeedsRefresh) {
+				return aNeedsRefresh ? 1 : -1;
+			}
+
+			// If both need refresh or both are fresh, prefer less used accounts
+			const aUsage = a.session_request_count || 0;
+			const bUsage = b.session_request_count || 0;
+			return aUsage - bUsage;
+		});
+
+		// Pick the first available account and start a new session with it
+		const chosenAccount = available[0];
+		this.resetSessionIfExpired(chosenAccount);
+
+		if (this.needsOAuthRefresh(chosenAccount, now)) {
+			this.log.info(
+				`Starting session with account ${chosenAccount.name} (OAuth needs refresh)`,
+			);
+		} else {
+			this.log.info(
+				`Starting session with account ${chosenAccount.name} (OAuth fresh until ${chosenAccount.expires_at ? new Date(chosenAccount.expires_at).toISOString() : "unknown"})`,
+			);
+		}
+
+		// Return chosen account first, then others as fallback
+		const others = available.filter((a) => a.id !== chosenAccount.id);
+		return [chosenAccount, ...others];
+	}
+}
