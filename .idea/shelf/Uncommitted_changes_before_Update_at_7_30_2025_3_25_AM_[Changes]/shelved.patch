+import type {
+	Account,
+	LoadBalancingStrategy,
+	RequestMeta,
+	StrategyStore,
+} from "@ccflare/core";
+import { isAccountAvailable } from "@ccflare/core";
+import { Logger } from "@ccflare/logger";
+
+/**
+ * Model-aware strategy that routes requests based on Claude model compatibility
+ * with account plans (Pro vs Max)
+ */
+export class ModelAwareStrategy implements LoadBalancingStrategy {
+	private store: StrategyStore | null = null;
+	private log = new Logger("ModelAwareStrategy");
+
+	initialize(store: StrategyStore): void {
+		this.store = store;
+	}
+
+	private getRequiredTier(model?: string): number {
+		if (!model) return 1; // Default to lowest tier for unknown models
+
+		const normalizedModel = model.toLowerCase();
+
+		// Claude 3.5 Sonnet and Haiku are available on all tiers
+		if (
+			normalizedModel.includes("claude-3-5-sonnet") ||
+			normalizedModel.includes("claude-3-haiku")
+		) {
+			return 1;
+		}
+
+		// Claude 3 Opus typically requires higher tiers
+		if (normalizedModel.includes("claude-3-opus")) {
+			return 5; // Require at least Pro
+		}
+
+		// Future premium models might require Max tier
+		if (
+			normalizedModel.includes("claude-4") ||
+			normalizedModel.includes("premium")
+		) {
+			return 20; // Require Max tier
+		}
+
+		return 1; // Default to lowest tier
+	}
+
+	select(accounts: Account[], meta: RequestMeta): Account[] {
+		const now = Date.now();
+		const available = accounts.filter((a) => isAccountAvailable(a, now));
+
+		if (available.length === 0) {
+			this.log.warn("No available accounts for model-aware selection");
+			return [];
+		}
+
+		// Extract model from request metadata
+		const model = meta.model;
+		const requiredTier = this.getRequiredTier(model);
+
+		// Filter accounts that can handle the required model
+		const compatible = available.filter(
+			(account) => (account.account_tier || 1) >= requiredTier,
+		);
+
+		if (compatible.length === 0) {
+			this.log.warn(
+				`No accounts compatible with model ${model} (tier ${requiredTier} required)`,
+			);
+			// Fallback to all available accounts
+			return available;
+		}
+
+		// Sort compatible accounts by tier (higher tier first) and then by usage
+		compatible.sort((a, b) => {
+			const aTier = a.account_tier || 1;
+			const bTier = b.account_tier || 1;
+
+			if (aTier !== bTier) {
+				return bTier - aTier; // Higher tier first
+			}
+
+			// Tiebreaker: prefer accounts with lower session usage
+			const aUsage = a.session_request_count || 0;
+			const bUsage = b.session_request_count || 0;
+			return aUsage - bUsage;
+		});
+
+		const selectedAccount = compatible[0];
+		this.log.info(
+			`Model-aware selected account ${selectedAccount.name} for model ${model} (tier: ${selectedAccount.account_tier})`,
+		);
+
+		// Return compatible accounts first, then others as fallback
+		const others = available.filter((a) => a.id !== selectedAccount.id);
+		return [selectedAccount, ...others];
+	}
+}
