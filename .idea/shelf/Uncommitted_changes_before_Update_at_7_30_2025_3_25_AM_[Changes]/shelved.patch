@@ -0,0 +1,186 @@
+import { Logger } from "@ccflare/logger";
+import type { StrategyStore } from "./strategy-store";
+import type { Account } from "./types";
+
+// Provider interface for OAuth operations
+interface OAuthProvider {
+	refreshToken(
+		account: Account,
+		clientId: string,
+	): Promise<{
+		accessToken: string;
+		expiresAt: number;
+		refreshToken?: string;
+	}>;
+}
+
+/**
+ * OAuth session manager that handles token refresh and session lifecycle
+ */
+export class OAuthManager {
+	private log = new Logger("OAuthManager");
+	private refreshInFlight = new Map<string, Promise<void>>();
+	private refreshBuffer: number; // Buffer time before expiry to trigger refresh
+
+	constructor(refreshBuffer: number = 30 * 60 * 1000) {
+		// 30 minutes default
+		this.refreshBuffer = refreshBuffer;
+	}
+
+	/**
+	 * Check if an account's OAuth token needs refresh
+	 */
+	needsRefresh(account: Account, now: number = Date.now()): boolean {
+		if (!account.expires_at) return true;
+		return account.expires_at - now <= this.refreshBuffer;
+	}
+
+	/**
+	 * Check if an account's OAuth token is expired
+	 */
+	isExpired(account: Account, now: number = Date.now()): boolean {
+		if (!account.expires_at) return true;
+		return account.expires_at <= now;
+	}
+
+	/**
+	 * Schedule token refresh for accounts that need it
+	 * This can be called periodically to proactively refresh tokens
+	 */
+	async scheduleRefresh(
+		accounts: Account[],
+		store: StrategyStore,
+		provider: OAuthProvider,
+		clientId: string,
+	): Promise<void> {
+		const now = Date.now();
+		const needsRefresh = accounts.filter(
+			(account) =>
+				this.needsRefresh(account, now) &&
+				!this.refreshInFlight.has(account.id),
+		);
+
+		if (needsRefresh.length === 0) return;
+
+		this.log.info(
+			`Scheduling OAuth refresh for ${needsRefresh.length} accounts: ${needsRefresh.map((a) => a.name).join(", ")}`,
+		);
+
+		// Start refresh for all accounts that need it
+		const refreshPromises = needsRefresh.map((account) =>
+			this.refreshAccount(account, store, provider, clientId),
+		);
+
+		// Wait for all refreshes to complete (or fail)
+		await Promise.allSettled(refreshPromises);
+	}
+
+	/**
+	 * Refresh OAuth token for a specific account
+	 * Includes stampede prevention
+	 */
+	async refreshAccount(
+		account: Account,
+		store: StrategyStore,
+		provider: OAuthProvider,
+		clientId: string,
+	): Promise<void> {
+		// Check if refresh is already in flight
+		if (this.refreshInFlight.has(account.id)) {
+			this.log.info(`Waiting for existing refresh for account ${account.name}`);
+			await this.refreshInFlight.get(account.id);
+			return;
+		}
+
+		// Start refresh
+		const refreshPromise = this._doRefresh(account, store, provider, clientId);
+		this.refreshInFlight.set(account.id, refreshPromise);
+
+		try {
+			await refreshPromise;
+		} finally {
+			this.refreshInFlight.delete(account.id);
+		}
+	}
+
+	private async _doRefresh(
+		account: Account,
+		store: StrategyStore,
+		provider: OAuthProvider,
+		clientId: string,
+	): Promise<void> {
+		try {
+			this.log.info(`Refreshing OAuth token for account ${account.name}`);
+
+			const result = await provider.refreshToken(account, clientId);
+
+			// Update account with new token info
+			account.access_token = result.accessToken;
+			account.expires_at = result.expiresAt;
+
+			// Update refresh token if provided
+			if (result.refreshToken) {
+				account.refresh_token = result.refreshToken;
+			}
+
+			// Persist changes to database if store supports it
+			if (store.updateAccount) {
+				store.updateAccount(account);
+			}
+
+			this.log.info(
+				`OAuth token refreshed for account ${account.name}, expires at ${new Date(result.expiresAt).toISOString()}`,
+			);
+		} catch (error) {
+			this.log.error(
+				`Failed to refresh OAuth token for account ${account.name}: ${error}`,
+			);
+
+			// Mark account as having authentication issues
+			// The account will be filtered out by isAccountAvailable until token is fixed
+			account.expires_at = 0; // Mark as expired
+
+			throw error;
+		}
+	}
+
+	/**
+	 * Get OAuth session status for an account
+	 */
+	getSessionStatus(
+		account: Account,
+		now: number = Date.now(),
+	): {
+		isValid: boolean;
+		needsRefresh: boolean;
+		expiresIn: number;
+		status: "valid" | "needs_refresh" | "expired" | "missing";
+	} {
+		if (!account.expires_at) {
+			return {
+				isValid: false,
+				needsRefresh: true,
+				expiresIn: 0,
+				status: "missing",
+			};
+		}
+
+		const expiresIn = account.expires_at - now;
+		const isExpired = expiresIn <= 0;
+		const needsRefresh = expiresIn <= this.refreshBuffer;
+
+		return {
+			isValid: !isExpired,
+			needsRefresh,
+			expiresIn,
+			status: isExpired ? "expired" : needsRefresh ? "needs_refresh" : "valid",
+		};
+	}
+}
+
+// Extend StrategyStore interface to support OAuth updates
+declare module "./strategy-store" {
+	interface StrategyStore {
+		updateAccount?(account: Account): void;
+	}
+}
