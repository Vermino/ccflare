+import type {
+	Account,
+	LoadBalancingStrategy,
+	RequestMeta,
+	StrategyStore,
+} from "@ccflare/core";
+import { isAccountAvailable } from "@ccflare/core";
+import { Logger } from "@ccflare/logger";
+
+/**
+ * Weighted strategy that uses account tier to determine selection probability
+ * Higher tier accounts (Pro = 5x, Max = 20x) get more requests
+ */
+export class WeightedStrategy implements LoadBalancingStrategy {
+	private store: StrategyStore | null = null;
+	private log = new Logger("WeightedStrategy");
+
+	initialize(store: StrategyStore): void {
+		this.store = store;
+	}
+
+	private getAccountWeight(account: Account): number {
+		// Weight based on account tier: 1 (free), 5 (pro), 20 (max)
+		return account.account_tier || 1;
+	}
+
+	select(accounts: Account[], _meta: RequestMeta): Account[] {
+		const now = Date.now();
+		const available = accounts.filter((a) => isAccountAvailable(a, now));
+
+		if (available.length === 0) {
+			this.log.warn("No available accounts for weighted selection");
+			return [];
+		}
+
+		// Calculate total weight
+		const totalWeight = available.reduce(
+			(sum, account) => sum + this.getAccountWeight(account),
+			0,
+		);
+
+		// Generate random number between 0 and totalWeight
+		const randomWeight = Math.random() * totalWeight;
+		let currentWeight = 0;
+		let selectedAccount: Account | null = null;
+
+		// Find the account that corresponds to the random weight
+		for (const account of available) {
+			currentWeight += this.getAccountWeight(account);
+			if (randomWeight <= currentWeight) {
+				selectedAccount = account;
+				break;
+			}
+		}
+
+		// Fallback to first account if selection failed
+		if (!selectedAccount) {
+			selectedAccount = available[0];
+		}
+
+		const weight = this.getAccountWeight(selectedAccount);
+		this.log.info(
+			`Weighted selected account ${selectedAccount.name} (weight: ${weight}/${totalWeight})`,
+		);
+
+		// Return selected account first, then others sorted by weight (descending)
+		const others = available
+			.filter((a) => a.id !== selectedAccount?.id)
+			.sort((a, b) => this.getAccountWeight(b) - this.getAccountWeight(a));
+
+		return [selectedAccount, ...others];
+	}
+}
